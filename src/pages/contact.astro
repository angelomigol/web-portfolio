---
/**
 * Contact Page
 *
 * Sections:
 - - Zone 1 (Primary): Email address with context about response time
 * - Zone 2 (Secondary): Social media links (only shown if configured)
 *
 * Route: /contact
 *
 * @page
 */

import MainLayout from "@/layouts/main.astro"
import SEO from "@/components/SEO.astro"
import { siteConfig, socialLinks } from "@/config"
import { pagesConfig } from "@/pages.config"
---

<MainLayout>
  <SEO
    slot={"head"}
    title={pagesConfig.contact.title}
    description={pagesConfig.contact.description}
    type="website"
  />

  <main
    class="mx-auto max-w-175 px-6 pt-12 pb-32 max-sm:px-4 max-sm:pt-16 max-sm:pb-24"
  >
    <section class="mb-12 max-sm:mb-16">
      <h1
        class="mb-6 text-lg font-medium tracking-[0.01em] text-muted-foreground max-sm:text-base"
      >
        {pagesConfig.contact.heading}
      </h1>
      <a
        href=`mailto:${siteConfig.author.email}`
        class="mb-6 block text-4xl font-semibold tracking-tight transition-colors hover:text-secondary-foreground"
        >{siteConfig.author.email}</a
      >
      <p class="text-base/relaxed text-muted-foreground">
        I read every email. Expect a reply within a few days.
      </p>
    </section>

    {
      socialLinks.length > 0 && (
        <section class="border-t border-t-border pt-12">
          <h2 class="mb-4 text-sm font-medium tracking-wider text-muted-foreground uppercase">
            Socials
          </h2>
          <div class="flex flex-wrap items-center gap-2">
            {socialLinks.map((link, index) => (
              <>
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-base text-secondary-foreground no-underline transition-colors hover:text-foreground"
                >
                  {link.platform}
                </a>
                {index < socialLinks.length - 1 && (
                  <span class="text-muted-foreground select-none">·</span>
                )}
              </>
            ))}
          </div>
        </section>
      )
    }
  </main>
</MainLayout>
