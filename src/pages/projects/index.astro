---
/**
 * Projects Index Page
 *
 * Lists all projects as with impact summaries. Projects are displayed
 * in a prioritized order: custom order (if specified) takes precedence, otherwise
 * sorted by year (most recent first). Featured projects are highlighted.
 *
 * Route: /projects
 *
 * @page
 */

import MainLayout from "@/layouts/main.astro"
import SEO from "@/components/SEO.astro"
import { getCollection } from "astro:content"
import { pagesConfig } from "@/pages.config"
import ForwardLink from "@/components/ForwardLink.astro"

const allProjects = await getCollection("projects")

const sortedProjects = allProjects.sort((a, b) => {
  if (a.data.order !== undefined && b.data.order !== undefined) {
    return a.data.order - b.data.order
  }
  if (a.data.order !== undefined) return -1
  if (b.data.order !== undefined) return 1
  return b.data.year - a.data.year
})

const totalProjects = sortedProjects.length
const featuredCount = sortedProjects.filter((p) => p.data.featured).length

const statusConfig = {
  completed: { label: "Completed", class: "status--completed" },
  ongoing: {
    label: "Ongoing",
    class: "bg-[#22c55e26] text-[#22c55e]",
  },
  archived: {
    label: "Archived",
    class: "bg-[#73737326] text-muted-foreground",
  },
}
---

<MainLayout>
  <SEO
    slot="head"
    title={pagesConfig.projects.title}
    description={pagesConfig.projects.description}
    type="website"
  />

  <main class="mx-auto max-w-200 px-6 py-8 max-md:px-4 max-md:py-6">
    <header class="mb-12">
      <h1 class="mb-4 text-4xl font-bold tracking-tight max-md:text-[2rem]">
        {pagesConfig.projects.heading}
      </h1>
      <p
        class="max-w-175 text-lg/relaxed text-secondary-foreground max-md:text-base/relaxed"
      >
        {pagesConfig.projects.intro}
      </p>
      <p class="mt-4 text-sm text-muted-foreground">
        {`${totalProjects} projects · ${featuredCount} featured`}
      </p>
    </header>

    {
      sortedProjects.length > 0 ? (
        <div class="flex flex-col gap-8">
          {sortedProjects.map((project) => {
            const statusInfo = statusConfig[project.data.status]
            const displayTech = project.data.techStack.slice(0, 4)
            const hasMoreTech = project.data.techStack.length > 4

            return (
              <div class="relative block rounded-[8px] border bg-secondary px-7 py-6 transition-all hover:border-muted-foreground hover:bg-[#fafafa] in-data-[theme=dark]:hover:bg-[#1a1a1a] max-[640px]:px-6 max-[640px]:py-5">
                <div class="mb-3 flex items-center gap-3 empty:hidden">
                  {project.data.featured && (
                    <span class="inline-flex items-center gap-1.5 text-xs font-semibold tracking-wider text-accent-foreground uppercase">
                      <svg
                        width="12"
                        height="12"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="shrink-0"
                      >
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                      </svg>
                      Featured
                    </span>
                  )}
                  {project.data.status !== "completed" && (
                    <span
                      class:list={[
                        "inline-flex items-center rounded-[6px] px-2 py-1 text-[0.625rem] font-semibold tracking-wider uppercase",
                        statusInfo.class,
                      ]}
                    >
                      {statusInfo.label}
                    </span>
                  )}
                </div>
                <span class="mb-2 block text-xs font-semibold tracking-[0.08em] text-muted-foreground uppercase">
                  {project.data.role} · {project.data.year}
                </span>
                <span class="mb-2.5 block text-lg/snug font-semibold max-[640px]:text-base/snug">
                  {project.data.title}
                </span>
                <span class="mb-4 block text-sm text-secondary-foreground">
                  {project.data.outcomeSummary}
                </span>

                {displayTech.length > 0 && (
                  <div class="mb-4 flex flex-wrap gap-2 max-md:gap-1.5">
                    {displayTech.map((tech) => (
                      <span class="rounded-[5px] border bg-background px-2.5 py-1 text-xs text-secondary-foreground max-md:px-2 max-md:py-0.5 max-md:text-[0.6875rem]">
                        {tech}
                      </span>
                    ))}
                    {hasMoreTech && (
                      <span class="px-2 py-1 text-xs text-muted-foreground">
                        +{project.data.techStack.length - 4}
                      </span>
                    )}
                  </div>
                )}

                <ForwardLink
                  href={`/projects/${project.id}`}
                  text="View details"
                />
              </div>
            )
          })}
        </div>
      ) : (
        <p class="text-lg text-secondary-foreground italic">
          No Projects Available Yet.
        </p>
      )
    }
  </main>
</MainLayout>
