---
/**
 * Case Study Detail Page
 *
 * Narrative Structure (enforced order):
 * 1. Overview - High-level project summary
 * 2. Problem - Challenge being addressed
 * 3. Constraints - Limitations and boundaries
 * 4. Approach - Solution strategy
 * 5. Key Decisions - Technical choices with reasoning and alternatives
 * 6. Tech Stack - Technologies used
 * 7. Result & Impact - Quantitative metrics and qualitative outcomes
 * 8. Learnings - Insights and takeaways
 *
 * Route: /projects/[slug]
 *
 * @page
 */

import MainLayout from "@/layouts/main.astro"
import SEO from "@/components/SEO.astro"
import StructuredData from "@/components/StructuredData.astro"
// import ScrollToTop from '../../components/ScrollToTop.astro';
// import BackLink from '../../components/BackLink.astro';
// import RelatedContent from '../../components/RelatedContent.astro';
// import ImpactMetrics from '../../components/ImpactMetrics.astro';
import { getCollection, getEntry, render } from "astro:content"

export async function getStaticPaths() {
  const projects = await getCollection("projects")
  return projects.map((project) => ({
    params: { slug: project.id },
  }))
}

const { slug } = Astro.params

const project = await getEntry("projects", slug!)

if (!project) {
  return Astro.redirect("/404")
}

const { Content } = await render(project)

const {
  title,
  role,
  year,
  duration,
  teamSize,
  outcomeSummary,
  overview,
  problem,
  constraints,
  approach,
  keyDecisions,
  techStack,
  impact,
  learnings,
  relatedProjects,
  status,
} = project.data

const statusConfig = {
  completed: { label: "Completed", class: "status--completed" },
  ongoing: {
    label: "Ongoing",
    class: "bg-[#22c55e26] text-[#22c55e]",
  },
  archived: {
    label: "Archived",
    class: "bg-[#73737326] text-muted-foreground",
  },
}
const statusInfo = statusConfig[status || "completed"]
---

<MainLayout>
  <SEO
    slot="head"
    title={`${title}`}
    description={outcomeSummary}
    type="article"
  />

  <StructuredData
    type="Project"
    data={{
      title,
      outcomeSummary,
      problem,
      impact: impact.qualitative,
      techStack,
      year,
    }}
  />

  <main class="mx-auto max-w-200 px-6 py-8 max-md:px-4 max-md:py-6">
    <header class="mb-12 border-b pb-8">
      <div class="mb-3 empty:hidden">
        {
          status && status !== "completed" && (
            <span
              class:list={[
                "inline-flex items-center rounded-[6px] px-2 py-1 text-[0.625rem] font-semibold tracking-wider uppercase",
                statusInfo.class,
              ]}
            >
              {statusInfo.label}
            </span>
          )
        }
      </div>
      <h1
        class="mb-4 text-4xl/tight font-bold tracking-tight max-md:text-3xl/tight"
      >
        {title}
      </h1>
      <div class="mb-6 flex items-center gap-3 text-secondary-foreground">
        <span>{role}</span>
        <span class="opacity-50">·</span>
        <span>{year}</span>
        {
          duration && (
            <>
              <span class="opacity-50">·</span>
              <span>{duration}</span>
            </>
          )
        }
        {
          teamSize && (
            <>
              <span class="opacity-50">·</span>
              <span>
                {teamSize} {teamSize === 1 ? "person" : "people"}
              </span>
            </>
          )
        }
      </div>
      <p class="text-lg/relaxed text-secondary-foreground">{outcomeSummary}</p>
    </header>

    <section class="mb-12">
      <h2 class="mb-5 text-3xl font-bold tracking-[-0.01em] max-md:text-2xl">
        Overview
      </h2>
      <p
        class="text-lg/relaxed text-secondary-foreground max-md:text-base/relaxed"
      >
        {overview}
      </p>
    </section>

    <section class="mb-12">
      <h2 class="mb-5 text-3xl font-bold tracking-[-0.01em] max-md:text-2xl">
        Problem
      </h2>
      <p
        class="text-lg/relaxed text-secondary-foreground max-md:text-base/relaxed"
      >
        {problem}
      </p>
    </section>

    <section class="mb-12">
      <h2 class="mb-5 text-3xl font-bold tracking-[-0.01em] max-md:text-2xl">
        Constraints
      </h2>
      <ul>
        {
          constraints.map((constraint) => (
            <li class="relative py-2 pl-6 text-base/relaxed text-secondary-foreground before:absolute before:left-0 before:text-accent">
              {constraint}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mb-12">
      <h2 class="mb-5 text-3xl font-bold tracking-[-0.01em] max-md:text-2xl">
        Approach
      </h2>
      <p
        class="text-lg/relaxed text-secondary-foreground max-md:text-base/relaxed"
      >
        {approach}
      </p>
    </section>

    <section class="mb-12">
      <h2 class="mb-5 text-3xl font-bold tracking-[-0.01em] max-md:text-2xl">
        Key Decisions
      </h2>
      <div class="flex flex-col gap-8">
        {
          keyDecisions.map((decision) => (
            <div class="rounded-[8px] border bg-secondary p-6 max-md:p-5">
              <h3 class="mb-4 text-xl font-semibold">{decision.decision}</h3>
              <div class="mt-4">
                <strong class="mb-2 block text-sm tracking-wider text-muted-foreground uppercase">
                  Reasoning:
                </strong>
                <p class="mt-2 text-secondary-foreground">
                  {decision.reasoning}
                </p>
              </div>
              {decision.alternatives && decision.alternatives.length > 0 && (
                <div class="mt-4">
                  <strong class="mb-2 block text-sm tracking-wider text-muted-foreground uppercase">
                    Alternatives considered:
                  </strong>
                  <ul class="py-1 pl-5 text-base/relaxed text-secondary-foreground">
                    {decision.alternatives.map((alt) => (
                      <li class="before:absolute before:left-0 before:text-accent">
                        {alt}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          ))
        }
      </div>
    </section>

    <section class="mb-12">
      <h2 class="mb-5 text-3xl font-bold tracking-[-0.01em] max-md:text-2xl">
        Tech Stack
      </h2>
      <ul>
        {
          techStack.map((tech) => (
            <li class="relative py-2 pl-6 text-base/relaxed text-secondary-foreground before:absolute before:left-0 before:text-accent">
              {tech}
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Result/Impact Section -->
    <!-- <section class="mb-12">
      <h2 class="mb-5 text-3xl font-bold tracking-[-0.01em] max-md:text-2xl">
        Result & Impact
      </h2>

      {/* Display metrics with visualization */}
      {
        impact.metrics && impact.metrics.length > 0 && (
          <ImpactMetrics metrics={impact.metrics} />
        )
      }

      <p class="text-lg/relaxed text-secondary-foreground">
        {impact.qualitative}
      </p>
    </section> -->

    <section class="mb-12">
      <h2 class="mb-5 text-3xl font-bold tracking-[-0.01em]">Learnings</h2>
      <ul>
        {
          learnings.map((learning) => (
            <li class="relative py-2 pl-6 text-base/relaxed text-secondary-foreground before:absolute before:left-0 before:text-accent">
              {learning}
            </li>
          ))
        }
      </ul>
    </section>

    {
      Content && (
        <section class="mt-12 text-base/relaxed text-secondary-foreground">
          <Content />
        </section>
      )
    }

    <!-- <RelatedContent
      relatedProjects={relatedProjects}
      relatedDecisions={relatedDecisions}
    /> -->

    <div class="mt-12 border-t pt-8">
      <a
        href="/web-portfolio/projects"
        class="inline-flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:-translate-x-0.75 hover:text-foreground"
      >
        <svg
          class="h-4 w-4 transition-all hover:-translate-x-0.75"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="currentColor"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M9.70711 17.2929C10.0976 17.6834 10.0976 18.3166 9.70711 18.7071C9.31658 19.0976 8.68342 19.0976 8.29289 18.7071L2.29289 12.7071C1.90237 12.3166 1.90237 11.6834 2.29289 11.2929L8.29289 5.29289C8.68342 4.90237 9.31658 4.90237 9.70711 5.29289C10.0976 5.68342 10.0976 6.31658 9.70711 6.70711L5.41421 11L21 11C21.5523 11 22 11.4477 22 12C22 12.5523 21.5523 13 21 13L5.41422 13L9.70711 17.2929Z"
          ></path>
        </svg>
        All Projects
      </a>
    </div>
  </main>
</MainLayout>
