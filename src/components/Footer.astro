---
/**
 * Footer Component
 *
 * @component
 *
 * @example
 * ```astro
 * <Footer />
 * ```
 */

import { siteConfig, socialLinks } from "@/config"

const currentYear = new Date().getFullYear()
---

<footer class="mt-auto border-t border-t-border px-6 py-8">
  <div
    class="mx-auto my-0 flex max-w-275 items-center justify-between gap-4 max-[480px]:flex-col max-[480px]:items-center max-[480px]:gap-3"
  >
    <span class="copyright text-sm text-muted-foreground"
      >© {currentYear} {siteConfig.author.name}</span
    >

    {
      socialLinks.length > 0 && (
        <div class="flex items-center gap-2">
          {socialLinks.map((link, index) => (
            <>
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-muted-foreground no-underline transition-colors hover:text-foreground"
              >
                {link.platform}
              </a>
              {index < socialLinks.length - 1 && (
                <span class="text-muted-foreground/50 select-none">·</span>
              )}
            </>
          ))}
        </div>
      )
    }
  </div>
</footer>
